# === ThrowOff Produktion ===
# Liegt auf dem Server unter /srv/throwoff/shared/env/.env.prod (chmod 600).

# PostgreSQL (internes Docker-Netzwerk)
POSTGRES_USER=throwoff
POSTGRES_PASSWORD=bitte-starkes-passwort-generieren
POSTGRES_DB=throwoff

# Better Auth & App-URL (Secret erzeugen mit: openssl rand -hex 32)
BETTER_AUTH_SECRET=bitte-mindestens-32-zeichen-zufallsstring-setzen
BETTER_AUTH_URL=https://throwoff.app
NEXT_PUBLIC_APP_URL=https://throwoff.app
BETTER_AUTH_TRUSTED_ORIGINS=https://throwoff.app

# Loopback-Port, auf dem nginx die App erreicht
THROWOFF_APP_PORT=3003
