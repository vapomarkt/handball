# PostgreSQL Datenbankverbindung (Standard für docker-compose.yml)
DATABASE_URL="postgresql://throwoff:throwoff_dev_password@localhost:5432/throwoff?schema=public"

# Better Auth Konfiguration (Produktion: https://throwoff.app)
BETTER_AUTH_SECRET="replace-with-a-secure-32-char-random-secret-in-production"
BETTER_AUTH_URL="http://localhost:3000"

# Öffentliche App-URL für Einladungs- & Claim-Links (Produktion: https://throwoff.app)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
