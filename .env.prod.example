# === ThrowOff Produktion (.env auf dem Hetzner-Server) ===
# Kopieren via: cp .env.prod.example .env

# PostgreSQL (internes Docker-Netzwerk)
POSTGRES_USER=throwoff
POSTGRES_PASSWORD=bitte-starkes-passwort-generieren
POSTGRES_DB=throwoff

# Better Auth & App-URL (Secret erzeugen mit: openssl rand -hex 32)
BETTER_AUTH_SECRET=bitte-mindestens-32-zeichen-zufallsstring-setzen
BETTER_AUTH_URL=https://throwoff.app
NEXT_PUBLIC_APP_URL=https://throwoff.app
BETTER_AUTH_TRUSTED_ORIGINS=https://www.throwoff.app

# Reverse Proxy (nginx-proxy + acme-companion)
VIRTUAL_HOST=throwoff.app,www.throwoff.app
LETSENCRYPT_HOST=throwoff.app,www.throwoff.app
LETSENCRYPT_EMAIL=hello@throwoff.app

# Name des externen Docker-Netzwerks von nginx-proxy auf dem Server
# Prüfen auf dem Hetzner-Server mit: docker network ls
PROXY_NETWORK=nginx-proxy
